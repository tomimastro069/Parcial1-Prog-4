DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/appdb

# --- SEGURIDAD JWT ---
# Generá una llave larga y aleatoria. Podés usar: openssl rand -hex 32
SECRET_KEY=tu_secret_key_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CLOUDINARY ---
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_URL=cloudinary://tu_api_key:tu_api_secret@tu_cloud_name

# --- FRONTEND ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- MERCADO PAGO ---
TEST_ACCESS_TOKEN_MP=tu_test_access_token_mp
PUBLIC_KEY_MP=tu_public_key_mp
